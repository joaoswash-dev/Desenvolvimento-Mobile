NODE_ENV=production
PORT=3000

# Database (PostgreSQL - Railway)
# No Railway, defina como variável de referência: ${{Postgres.DATABASE_URL}}
# Localmente, cole aqui a "Public Networking" connection string do banco do Railway
DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT
JWT_SECRET=clima-tech-production-secret-key-change-this-before-deploy
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://seu-dominio.com,https://www.seu-dominio.com,http://localhost:3000,http://localhost:8081
